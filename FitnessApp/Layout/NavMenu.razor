<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href=""><span class="brand-mark">G</span> Garro's Bootcamp</a>
        <button title="Navigation öffnen" aria-label="Navigation öffnen" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="willkommen">
                <span class="nav-icon" aria-hidden="true">◌</span> Willkommen
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon" aria-hidden="true">⌂</span> Übersicht
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="training">
                <span class="nav-icon" aria-hidden="true">＋</span> Training
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="uebungen">
                <span class="nav-icon" aria-hidden="true">◆</span> Übungen
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="verlauf">
                <span class="nav-icon" aria-hidden="true">≡</span> Verlauf
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="fortschritt">
                <span class="nav-icon" aria-hidden="true">↗</span> Fortschritt
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="einstellungen">
                <span class="nav-icon" aria-hidden="true">⚙</span> Einstellungen
            </NavLink>
        </div>
        @if (canManageUsers)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="benutzer">
                    <span class="nav-icon" aria-hidden="true">◎</span> Benutzer
                </NavLink>
            </div>
        }
        @if (isAuthenticated)
        {
            <div class="nav-item px-3">
                <button type="button" class="nav-link nav-button" @onclick="LogoutAsync">
                    <span class="nav-icon" aria-hidden="true">↩</span> Abmelden
                </button>
            </div>
        }
    </nav>
</div>

@code {
    [Inject]
    private AuthService Auth { get; set; } = default!;

    private bool collapseNavMenu = true;
    private bool canManageUsers;
    private bool isAuthenticated;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await Auth.GetCurrentUserAsync();
        canManageUsers = currentUser.CanManageUsers;
        isAuthenticated = currentUser.AuthenticationMode == "Sql" && currentUser.IsAuthenticated;
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

@page "/verlauf"
@inject WorkoutService Workouts
@inject AuthService Auth

<PageTitle>Trainingsverlauf</PageTitle>

<header class="page-header">
    <span class="eyebrow">Aktivitäten</span>
    <h1>Trainingsverlauf</h1>
    <p>Öffne ein Training, prüfe die Werte und bearbeite es bei Bedarf.</p>
</header>

@if (items is null)
{
    <p class="muted">Einträge werden geladen …</p>
}
else if (items.Count == 0)
{
    <section class="app-card empty-state">
        <div class="empty-icon">＋</div>
        <h2>Noch kein Training</h2>
        <p>Erfasse deine erste Einheit und starte deine Serie.</p>
        <a class="app-button btn-primary" href="training">Training starten</a>
    </section>
}
else
{
    <div class="history-layout">
        <div class="workout-list">
            @foreach (var workout in items)
            {
                var previewExercise = workout.Exercises.FirstOrDefault(item => !string.IsNullOrWhiteSpace(item.ImageUrl));
                <article class="app-card workout-card history-card @(selectedWorkout?.Id == workout.Id ? "active" : null)" @onclick="() => SelectWorkout(workout)">
                    <div class="workout-date">
                        <strong>@workout.PerformedAt.ToString("dd")</strong>
                        <span>@workout.PerformedAt.ToString("MMM")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(previewExercise?.ImageUrl))
                    {
                        <img class="workout-preview-image" src="@previewExercise.ImageUrl" alt="@previewExercise.Name" loading="lazy" />
                    }
                    <div class="workout-main">
                        <h2>@workout.Name</h2>
                        <p>@workout.DurationMinutes Min. · @workout.Exercises.Count Übung(en)</p>
                        @foreach (var exercise in workout.Exercises)
                        {
                            <span class="chip">@ExerciseSummary(exercise)</span>
                        }
                    </div>
                    <button class="icon-button danger" title="Training löschen" @onclick="() => DeleteAsync(workout.Id)" @onclick:stopPropagation="true">×</button>
                </article>
            }
        </div>

        @if (selectedWorkout is not null)
        {
            <EditForm Model="selectedWorkout" OnValidSubmit="SaveSelectedWorkoutAsync" class="app-card history-detail">
                <DataAnnotationsValidator />
                <div class="section-heading history-detail-heading">
                    <div>
                        <span class="eyebrow">Training</span>
                        <h2>@selectedWorkout.Name</h2>
                    </div>
                    <div class="history-detail-actions">
                        @if (editing)
                        {
                            <button type="submit" class="app-button btn-primary">Speichern</button>
                            <button type="button" class="app-button secondary" @onclick="CancelEdit">Abbrechen</button>
                        }
                        else
                        {
                            <button type="button" class="app-button secondary" @onclick="() => editing = true">Bearbeiten</button>
                            <button type="button" class="app-button danger" @onclick="() => DeleteAsync(selectedWorkout.Id)">Training löschen</button>
                        }
                    </div>
                </div>

                <div class="compact-form-grid">
                    <div class="field field-wide">
                        <label for="detailName">Name</label>
                        <InputText id="detailName" @bind-Value="selectedWorkout.Name" disabled="@(!editing)" />
                    </div>
                    <div class="field">
                        <label for="detailDate">Datum</label>
                        <InputDate id="detailDate" @bind-Value="selectedWorkout.PerformedAt" disabled="@(!editing)" />
                    </div>
                    <div class="field">
                        <label for="detailDuration">Dauer (Min.)</label>
                        <InputNumber id="detailDuration" @bind-Value="selectedWorkout.DurationMinutes" disabled="@(!editing)" />
                    </div>
                </div>

                <div class="selected-exercise-list history-exercises">
                    @foreach (var exercise in selectedWorkout.Exercises)
                    {
                        <article class="selected-exercise">
                            <div class="selected-exercise-heading @(string.IsNullOrWhiteSpace(exercise.ImageUrl) ? "without-image" : null)">
                                <span class="exercise-number">@(selectedWorkout.Exercises.IndexOf(exercise) + 1)</span>
                                @if (!string.IsNullOrWhiteSpace(exercise.ImageUrl))
                                {
                                    <img class="selected-exercise-image" src="@exercise.ImageUrl" alt="@exercise.Name" loading="lazy" />
                                }
                                <div>
                                    <h3>@exercise.Name</h3>
                                    <span>@exercise.MuscleGroup</span>
                                </div>
                            </div>

                            @if (exercise.ExerciseType == ExerciseTypes.Endurance)
                            {
                                <div class="endurance-editor">
                                    <label><span>Dauer (Min.)</span><InputNumber @bind-Value="exercise.DurationMinutes" disabled="@(!editing)" /></label>
                                    <label><span>Entfernung (km)</span><InputNumber @bind-Value="exercise.DistanceKm" disabled="@(!editing)" /></label>
                                    <label><span>Höhenmeter</span><InputNumber @bind-Value="exercise.ElevationMeters" disabled="@(!editing)" /></label>
                                </div>
                            }
                            else if (UsesDuration(exercise))
                            {
                                <div class="other-activity-editor">
                                    <label><span>Dauer (Min.)</span><InputNumber @bind-Value="exercise.DurationMinutes" disabled="@(!editing)" /></label>
                                    <label><span>Intensität</span><InputNumber @bind-Value="exercise.Difficulty" disabled="@(!editing)" /></label>
                                </div>
                            }
                            else
                            {
                                <div class="set-editor">
                                    @for (var setIndex = 0; setIndex < exercise.SetEntries.Count; setIndex++)
                                    {
                                        var set = exercise.SetEntries[setIndex];
                                        <div class="set-row" @key="set">
                                            <strong class="set-number">@(setIndex + 1)</strong>
                                            <label><span>Wiederholungen</span><InputNumber @bind-Value="set.Repetitions" disabled="@(!editing)" /></label>
                                            <label><span>Gewicht (kg)</span><InputNumber @bind-Value="set.WeightKg" disabled="@(!editing)" /></label>
                                            <label class="difficulty-control"><span>Belastung</span><InputNumber @bind-Value="set.Difficulty" disabled="@(!editing)" /></label>
                                        </div>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>

                <div class="field notes-field">
                    <label for="detailNotes">Notizen</label>
                    <InputTextArea id="detailNotes" @bind-Value="selectedWorkout.Notes" disabled="@(!editing)" />
                </div>
            </EditForm>
        }
    </div>
}

@code {
    private IReadOnlyList<WorkoutSession>? items;
    private CurrentUserState currentUser = new();
    private WorkoutSession? selectedWorkout;
    private WorkoutSession? originalWorkout;
    private bool editing;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await Auth.GetCurrentUserAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        var allWorkouts = await Workouts.GetAllAsync();
        items = allWorkouts.Where(CanSeeWorkout).ToList();
    }

    private bool CanSeeWorkout(WorkoutSession workout)
    {
        if (workout.Visibility == WorkoutVisibility.Global)
        {
            return true;
        }

        if (currentUser.AuthenticationMode != "Sql" || !currentUser.IsAuthenticated)
        {
            return true;
        }

        return string.Equals(workout.OwnerUserName, currentUser.UserName, StringComparison.OrdinalIgnoreCase);
    }

    private void SelectWorkout(WorkoutSession workout)
    {
        selectedWorkout = CloneWorkout(workout);
        originalWorkout = CloneWorkout(workout);
        editing = false;
    }

    private void CancelEdit()
    {
        if (originalWorkout is not null)
        {
            selectedWorkout = CloneWorkout(originalWorkout);
        }
        editing = false;
    }

    private async Task SaveSelectedWorkoutAsync()
    {
        if (selectedWorkout is null)
        {
            return;
        }

        await Workouts.UpdateAsync(selectedWorkout);
        await RefreshAsync();
        originalWorkout = CloneWorkout(selectedWorkout);
        editing = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        await Workouts.DeleteAsync(id);
        await RefreshAsync();
        if (selectedWorkout?.Id == id)
        {
            selectedWorkout = null;
            originalWorkout = null;
            editing = false;
        }
    }

    private static string ExerciseSummary(ExerciseEntry exercise)
    {
        if (exercise.ExerciseType is ExerciseTypes.Endurance or ExerciseTypes.Other)
        {
            return $"{exercise.Name} · {exercise.DurationMinutes} Min." + (exercise.DistanceKm > 0 ? $" · {exercise.DistanceKm:0.##} km" : string.Empty);
        }

        var setCount = exercise.SetEntries.Count > 0 ? exercise.SetEntries.Count : exercise.Sets;
        return $"{exercise.Name} · {setCount} {(setCount == 1 ? "Satz" : "Sätze")}";
    }

    private static WorkoutSession CloneWorkout(WorkoutSession workout) => new()
    {
        Id = workout.Id,
        Name = workout.Name,
        OwnerUserName = workout.OwnerUserName,
        Visibility = workout.Visibility,
        PerformedAt = workout.PerformedAt,
        RecordedAt = workout.RecordedAt,
        DurationMinutes = workout.DurationMinutes,
        Notes = workout.Notes,
        Exercises = workout.Exercises.Select(CloneExercise).ToList()
    };

    private static ExerciseEntry CloneExercise(ExerciseEntry exercise) => new()
    {
        ExerciseId = exercise.ExerciseId,
        Name = exercise.Name,
        MuscleGroup = exercise.MuscleGroup,
        MuscleGroups = exercise.MuscleGroups.ToList(),
        ImageUrl = exercise.ImageUrl,
        ExerciseType = exercise.ExerciseType,
        Sets = exercise.Sets,
        Repetitions = exercise.Repetitions,
        WeightKg = exercise.WeightKg,
        DurationMinutes = exercise.DurationMinutes,
        DistanceKm = exercise.DistanceKm,
        ElevationMeters = exercise.ElevationMeters,
        Difficulty = exercise.Difficulty,
        SetEntries = exercise.SetEntries.Select(set => new ExerciseSetEntry
        {
            Repetitions = set.Repetitions,
            WeightKg = set.WeightKg,
            Difficulty = set.Difficulty
        }).ToList()
    };

    private static bool UsesDuration(ExerciseEntry exercise) =>
        exercise.ExerciseType == ExerciseTypes.Other
        || exercise.MuscleGroups.Contains("Ausdauer", StringComparer.OrdinalIgnoreCase)
        || string.Equals(exercise.MuscleGroup, "Ausdauer", StringComparison.OrdinalIgnoreCase);
}

@page "/einstellungen"
@inject SettingsService SettingsStore
@inject WorkoutService Workouts
@inject AuthService Auth

<PageTitle>Einstellungen</PageTitle>

<header class="page-header">
    <span class="eyebrow">Garro's Bootcamp anpassen</span>
    <h1>Einstellungen</h1>
    <p>Im SQL-Modus werden Anzeigename und Wochenziel geräteübergreifend im Benutzerkonto gespeichert; ohne Anmeldung bleiben die Einstellungen lokal.</p>
</header>

<EditForm Model="settings" OnValidSubmit="SaveAsync" class="app-card form-card">
    <DataAnnotationsValidator />
    <div class="form-grid">
        <div class="field field-wide">
            <label for="displayName">Anzeigename</label>
            <InputText id="displayName" @bind-Value="settings.DisplayName" />
            <ValidationMessage For="@(() => settings.DisplayName)" />
        </div>
        <div class="field field-wide">
            <label for="goal">Trainingsziel pro Woche</label>
            <InputNumber id="goal" @bind-Value="settings.WeeklyGoal" />
            <ValidationMessage For="@(() => settings.WeeklyGoal)" />
        </div>
        @if (currentUser.AuthenticationMode == "Sql" && currentUser.IsAuthenticated)
        {
            <label class="visibility-toggle field-wide" for="leaderboardPublic">
                <InputCheckbox id="leaderboardPublic" @bind-Value="leaderboardPublic" />
                <span>
                    <strong>Anzeigename in Ranglisten veröffentlichen</strong>
                    <small>Standardmäßig privat. Nur nach deiner Freigabe dürfen dein Anzeigename und deine Ranglistenwerte öffentlich erscheinen. Dein Benutzername bleibt verborgen.</small>
                </span>
            </label>
        }
    </div>
    <button class="app-button btn-primary" type="submit">Einstellungen speichern</button>
    @if (saved)
    {
        <span class="save-message">Gespeichert ✓</span>
    }
    @if (!string.IsNullOrWhiteSpace(saveError))
    {
        <p class="form-error" role="alert">@saveError</p>
    }
</EditForm>

<section class="app-card danger-zone">
    <div>
        <h2>Beispieldaten wiederherstellen</h2>
        <p>Alle eigenen Trainingseinträge werden durch die Demo-Einträge ersetzt.</p>
    </div>
    <button class="app-button secondary" @onclick="ResetAsync">Zurücksetzen</button>
</section>

@code {
    private UserSettings settings = new();
    private CurrentUserState currentUser = new();
    private UserProfile userProfile = new();
    private bool leaderboardPublic;
    private bool saved;
    private string? saveError;

    protected override async Task OnInitializedAsync()
    {
        settings = await SettingsStore.GetAsync();
        currentUser = await Auth.GetCurrentUserAsync();
        if (currentUser.AuthenticationMode == "Sql" && currentUser.IsAuthenticated)
        {
            settings.DisplayName = string.IsNullOrWhiteSpace(currentUser.DisplayName) ? currentUser.UserName ?? settings.DisplayName : currentUser.DisplayName;
            userProfile = await Auth.GetUserProfileAsync();
            settings.WeeklyGoal = userProfile.WeeklyGoal;
            leaderboardPublic = userProfile.IsLeaderboardPublic;
        }
    }

    private async Task SaveAsync()
    {
        saved = false;
        saveError = null;
        try
        {
            if (currentUser.AuthenticationMode == "Sql" && currentUser.IsAuthenticated)
            {
                await Auth.UpdateDisplayNameAsync(settings.DisplayName.Trim());
                userProfile = await Auth.UpdateUserProfileAsync(new UserProfile(settings.WeeklyGoal, leaderboardPublic));
            }

            await SettingsStore.SaveAsync(settings);
            saved = true;
        }
        catch (Exception exception)
        {
            saveError = exception.Message;
        }
    }

    private async Task ResetAsync()
    {
        await Workouts.ResetAsync();
        saved = true;
    }
}
